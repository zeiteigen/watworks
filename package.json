{
  "name": "waterlooworks-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local WaterlooWorks MCP server and browser-session bridge",
  "scripts": {
    "build": "bun node_modules/typescript/bin/tsc -p tsconfig.build.json",
    "typecheck": "bun node_modules/typescript/bin/tsc -p tsconfig.json --noEmit",
    "analyze-har": "bun scripts/analyze-har.ts",
    "verify-har": "bun scripts/verify-har.ts",
    "build:extension": "bun packages/extension/build.ts",
    "build:bridge": "bun build packages/bridge/src/index.ts --compile --outfile dist/waterlooworks-bridge",
    "test": "bun run typecheck && bun test",
    "start:mcp": "bun packages/mcp-server/src/index.ts",
    "start:bridge": "bun packages/bridge/src/index.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.326",
    "@types/node": "^24.10.0",
    "bun-types": "^1.3.5",
    "typescript": "^5.9.3"
  }
}
