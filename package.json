{
  "name": "watworks",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "WatWorks: hosted WaterlooWorks job search and application workspace, with its Chrome extension",
  "scripts": {
    "build:extension-release": "bun scripts/extension-release/build.ts",
    "build:extension": "bun packages/extension/build.ts",
    "setup": "bun scripts/setup.ts",
    "update": "bun scripts/update.ts",
    "build": "bun run typecheck && bun run build:extension",
    "typecheck": "bun node_modules/typescript/bin/tsc -p tsconfig.json --noEmit",
    "test": "bun run typecheck && bun test"
  },
  "dependencies": {
    "jose": "^6.2.15",
    "linkedom": "^0.18.14",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.5.438",
    "playwright": "^1.64.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261104.1",
    "@types/chrome": "^0.0.326",
    "@types/node": "^24.10.0",
    "bun-types": "^1.3.5",
    "miniflare": "5.20261103.0-beta",
    "typescript": "^5.9.3"
  }
}
