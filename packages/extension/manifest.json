{
  "manifest_version": 3,
  "name": "WaterlooWorks Workspace",
  "version": "0.1.0",
  "description": "Workspace access, browser applications, sign-in assistance, and independent daily job discovery.",
  "permissions": [
    "alarms",
    "storage",
    "notifications",
    "scripting",
    "nativeMessaging",
    "cookies"
  ],
  "host_permissions": [
    "https://watworks.alishahzad.dev/*",
    "https://waterlooworks.uwaterloo.ca/*",
    "http://127.0.0.1/*",
    "https://adfs.uwaterloo.ca/*",
    "https://sts.uwaterloo.ca/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "key": "",
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://[::1]/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "options_ui": {
    "page": "submission-settings.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "https://waterlooworks.uwaterloo.ca/*",
        "https://adfs.uwaterloo.ca/*",
        "https://sts.uwaterloo.ca/*"
      ],
      "js": [
        "page-content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
