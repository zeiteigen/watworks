node_modules/
**/dist/

# Authenticated captures and derived reports must remain outside version control.
*.har
*.har.json
waterlooworks-har-report*.json

.env
.env.*
*.log

# Personal files left by the retired local workspace: profile, resumes, saved jobs.
/data/

# Local tools and keys, such as the extension signing key backup.
/.tools/

# Per-user Claude Code settings.
/.claude/settings.local.json

# Browser inspection artifacts can contain authenticated page data.
.playwright-mcp/

# The public site build copied into the Insider proxy's assets by `bun run build:site-assets`.
/packages/insider-proxy/assets/site/

# Local Cloudflare emulator state and generated Worker bundles.
.wrangler/

# Local Worker secrets.
.dev.vars
.dev.vars.*

# Extension signing keys must never enter source control.
*.pem
*.key
*.p12
